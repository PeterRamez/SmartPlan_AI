# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI_PROVIDER=ollama | cloudflare
AI_PROVIDER=ollama
# Cloudflare Workers AI (server-side only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
# Embeddings are independently configurable. BGE-M3 is not assumed to be
# hosted by Cloudflare; use an Ollama-compatible endpoint or custom service.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=bge-m3
CUSTOM_EMBEDDING_URL=
CUSTOM_EMBEDDING_API_KEY=

# Google Drive service account; private key must contain escaped newlines.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Protect ingestion batch endpoint with a long random secret.
INGESTION_SECRET=
MAX_UPLOAD_MB=20
RAG_TOP_K=8
